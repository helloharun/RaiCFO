# Personal Finance HQ configuration. Copy to server/.env and fill in.
# NEVER commit server/.env, it is git-ignored.

# --- Server ---
NODE_ENV=production
# 127.0.0.1 = only reachable from this machine. Use 0.0.0.0 on hosts like Render (they terminate TLS for you).
HOST=127.0.0.1
# Render/Heroku-style hosts set PORT automatically.
PORT=4000
# Set to 1 (number of proxy hops) when running behind nginx/Caddy/Cloudflare so client IPs and HTTPS are detected.
TRUST_PROXY=
# Extra allowed browser origins, comma separated (normally empty: UI and API share one origin).
CORS_ORIGINS=

# --- Database (PostgreSQL, e.g. Supabase) ---
# Supabase: Project Settings > Database > Connection string (URI). Use the pooler URI on IPv4-only hosts such as Render.
# Tables are created automatically on first start. Keep this secret: it grants full access to your ledger.
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# auto = TLS for any non-localhost host (required by Supabase). Options: auto | disable | require | verify-full
DATABASE_SSL=auto
# Only for DATABASE_SSL=verify-full: the server CA certificate (PEM; \n escapes allowed).
DATABASE_CA_CERT=
# Max pooled connections (Supabase free tier allows few; 5 is plenty for one user).
DATABASE_POOL_MAX=5

# --- Login (single user, no sign-up) ---
APP_USERNAME=your-username
# Recommended: generate with  npm run hash-password -w server   and paste the result here (keep the single quotes).
APP_PASSWORD_HASH=
# Alternative (less secure): plain-text password, at least 12 characters. Ignored when APP_PASSWORD_HASH is set.
APP_PASSWORD=
# Random secret, at least 32 chars. Generate with:  npm run gen-secret -w server
SESSION_SECRET=change-me-generate-a-long-random-secret
# Log out after this many idle minutes, and always after SESSION_MAX_HOURS.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# auto = Secure cookies when NODE_ENV=production. Set false only for plain-http local use.
COOKIE_SECURE=auto
# Lock out an IP for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_ATTEMPTS failed logins.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=300

# --- AI (optional). Groq is used when GROQ_API_KEY is set; otherwise the built-in rule parser. ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Other providers (set LLM_PROVIDER=openai or anthropic):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Backups ---
# Optional: enables the "Download encrypted backup" button (AES-256-GCM, at least 32 chars).
# Store this somewhere safe: encrypted backups cannot be restored without it.
BACKUP_ENCRYPTION_KEY=

# Allow loading demo data into an empty ledger.
ALLOW_DEMO_DATA=false
